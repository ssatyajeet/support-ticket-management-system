# PostgreSQL connection string (replace with your local credentials)
DATABASE_URL="postgresql://user:password@localhost:5432/support_tickets"

# API server port
PORT=3001

# Allowed CORS origin (Vite dev server)
CLIENT_URL="http://localhost:5173"

# Integration tests use DATABASE_URL and truncate tables before each test.
# For isolation, use a dedicated database e.g. support_tickets_test
